{
    "audio": {
        "sample_rate": 16000,
        "chunk_size": 1024,
        "device": null,
        "reconnect_interval": 2.0,
        "max_reconnect_attempts": 5
    },
    "vad": {
        "adaptive_threshold": true,
        "noise_floor_window": 2.0,
        "sensitivity_multiplier": 2.0,
        "minimum_threshold": 0.004,
        "maximum_threshold": 0.05,
        "silence_duration": 0.45,
        "minimum_speech_duration": 0.20,
        "max_recording_duration": 6.0,
        "pre_roll_duration": 0.4
    },
    "voice": {
        "model": "base.en",
        "device": "cpu",
        "compute_type": "int8",
        "mode": "CONTINUOUS_COMMAND"
    },
    "transcription": {
        "min_log_probability": -1.75,
        "max_no_speech_probability": 0.6,
        "minimum_text_length": 2
    },
    "intent": {
        "conversation_threshold": 0.65,
        "action_threshold": 0.82,
        "global_cooldown": 2.0,
        "duplicate_intent_window": 5.0,
        "unknown_command_cooldown": 4.0,
        "dataset_path": "config/intent_keywords.json"
    },
    "tts": {
        "rate": 175,
        "volume": 1.0,
        "cooldown_duration": 0.3
    },
    "workflow": {
        "launch_verification_timeout": 10.0
    },
    "automation": {
        "enabled": true
    },
    "assistant": {
        "startup_greeting": true,
        "startup_message": "CLAPOS is online.",
        "completion_feedback": true
    },
    "workflows": {
        "dev_mode": {
            "name": "Developer Mode",
            "apps": [
                {
                    "name": "VS Code",
                    "path": "${VSCODE_PATH}"
                },
                {
                    "name": "Antigravity",
                    "path": "${ANTIGRAVITY_PATH}"
                },
                {
                    "name": "Google Chrome",
                    "path": "${CHROME_PATH}"
                }
            ]
        },
        "game_mode": {
            "name": "Gaming Mode",
            "apps": [
                {
                    "name": "VALORANT",
                    "path": "${VALORANT_PATH}"
                },
                {
                    "name": "Google Chrome",
                    "path": "${CHROME_PATH}"
                }
            ]
        },
        "entertainment_mode": {
            "name": "Entertainment Mode",
            "apps": [
                {
                    "name": "YouTube",
                    "path": "${CHROME_PATH}",
                    "arguments": "https://www.youtube.com"
                }
            ]
        }
    },
    "responses": {
        "DEVELOPER_MODE": [
            "Sure, opening your development environment.",
            "Developer mode activated.",
            "Alright, getting your coding workspace ready.",
            "Opening your development tools."
        ],
        "GAMING_MODE": [
            "Alright, switching to gaming mode.",
            "Gaming setup activated.",
            "Let's game.",
            "Launching your gaming environment."
        ],
        "ENTERTAINMENT_MODE": [
            "Sure, opening YouTube for you.",
            "Entertainment mode activated.",
            "Alright, kicking back with some YouTube.",
            "Opening YouTube in Chrome."
        ],
        "GREETING": [
            "Hey! What can I do for you?",
            "Hey! I'm listening.",
            "Hello! Ready for your command.",
            "Hi there! How can I help?"
        ],
        "STATUS": [
            "I'm running and ready for your command.",
            "Always listening.",
            "All systems normal, ready when you are."
        ],
        "UNKNOWN": [
            "I didn't quite understand that.",
            "Sorry, I don't know how to do that yet.",
            "Could you try saying that differently?"
        ]
    }
}