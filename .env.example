# Application Paths for CLAPOS Workflows (Copy this file to .env and adjust paths)
VSCODE_PATH=C:\Users\YOUR_USERNAME\AppData\Local\Programs\Microsoft VS Code\Code.exe
ANTIGRAVITY_PATH=C:\Users\YOUR_USERNAME\AppData\Local\Programs\Antigravity IDE\Antigravity IDE.exe
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
VALORANT_PATH=C:\Users\YOUR_USERNAME\Desktop\VALORANT.lnk
